{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Music manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "composition_id", "fps", "path", "duration_s", "duration_frames"],
  "properties": {
    "provider": { "type": "string" },
    "composition_id": { "type": "string" },
    "fps": { "type": "integer" },
    "path": { "type": "string" },
    "duration_s": { "type": "number" },
    "duration_frames": { "type": "integer" },
    "sample_rate": { "type": ["integer", "null"] },
    "channels": { "type": ["integer", "null"] },
    "prompt": { "type": "string" },
    "volume": { "type": "number" }
  }
}
