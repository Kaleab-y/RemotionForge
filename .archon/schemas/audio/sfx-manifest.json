{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SFX manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "composition_id", "fps", "cues"],
  "properties": {
    "provider": { "type": "string" },
    "composition_id": { "type": "string" },
    "fps": { "type": "integer" },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "fires_at", "duration_s", "duration_frames", "path_rel", "prompt"],
        "properties": {
          "id": { "type": "string" },
          "fires_at": { "type": "string" },
          "from_scene": { "type": "string" },
          "to_scene": { "type": "string" },
          "duration_s": { "type": "number" },
          "duration_frames": { "type": "integer" },
          "path_rel": { "type": "string" },
          "prompt": { "type": "string" },
          "sample_rate": { "type": ["integer", "null"] },
          "channels": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
